# Copy to .env and fill in your credentials. Never commit the real .env file.

# ERPNext / Frappe site
ERPNEXT_URL=https://your-site.erpnext.com
ERPNEXT_API_KEY=your-api-key
ERPNEXT_API_SECRET=your-api-secret
# Name of the selling price list whose gross prices should be exported.
ERPNEXT_PRICE_LIST=Standard Selling

# sevDesk
SEVDESK_API_TOKEN=your-sevdesk-api-token
SEVDESK_BASE_URL=https://my.sevdesk.de/api/v1

# Fallback VAT rate (in percent) used only when a sevDesk part has no tax
# rate set yet. Normally the tax rate already stored on the sevDesk part is
# used for the gross -> net conversion. Leave empty to skip such parts.
DEFAULT_TAX_RATE=19

# Set to true to only log what would change, without writing to sevDesk.
DRY_RUN=false
